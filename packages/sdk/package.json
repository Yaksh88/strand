{
  "name": "@strand/sdk",
  "version": "0.1.0",
  "description": "Durable workflows on Postgres for TypeScript.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
