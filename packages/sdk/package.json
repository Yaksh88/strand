  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "tsup": "^9.0.0",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "cron-parser": "^5.10.6",
    "pg": "^8.23.1",
    "pino": "^10.4.0"
