    "fastify-type-provider-zod": "^7.0.0",
    "pino": "^10.4.0",
    "prom-client": "^15.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "vitest": "^5.1.1"
  }
