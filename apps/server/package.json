{
  "name": "@strand/server",
  "version": "0.1.0",
  "description": "REST API for Strand: start, inspect and control workflow runs.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsup",
    "dev": "tsx watch src/index.ts",
